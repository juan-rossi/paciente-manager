generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  VIUDO
  CONCUBINO
}

enum UserRole {
  DOCTOR
  SECRETARY
  // Owner/staff de Semio 360 (no de un consultorio) -- ve todas las cuentas
  // de médicos de la plataforma para tomar decisiones de negocio (altas,
  // vencimientos, conversión, uso). No es un tenant: nunca tiene
  // `activeDoctorId` ni pacientes/turnos propios. Se crea a mano
  // (`scripts/create-admin.ts`), nunca por signup ni por OAuth de Google.
  ADMIN
}

enum PlanTipo {
  BASICA
  PREMIUM
}

enum TituloCortesia {
  DR
  DRA
  LIC
}

enum Especialidad {
  CLINICA_MEDICA
  MEDICINA_FAMILIAR_GENERAL
  PEDIATRIA
  GINECOLOGIA
  OBSTETRICIA
  CARDIOLOGIA
  DERMATOLOGIA
  ENDOCRINOLOGIA
  GASTROENTEROLOGIA
  TRAUMATOLOGIA_Y_ORTOPEDIA
  OFTALMOLOGIA
  OTORRINOLARINGOLOGIA
  NEUROLOGIA
  PSIQUIATRIA
  UROLOGIA
  REUMATOLOGIA
  NEUMONOLOGIA
  ALERGIA_E_INMUNOLOGIA
  INFECTOLOGIA
  NEFROLOGIA
  HEMATOLOGIA
  ONCOLOGIA
  GERIATRIA
  NUTRICION
  FLEBOLOGIA
  DIABETOLOGIA
  MEDICINA_DEL_DEPORTE
  MEDICINA_FISICA_Y_REHABILITACION_FISIATRIA
  MEDICINA_REPRODUCTIVA_FERTILIDAD
  MEDICINA_DEL_DOLOR
  MEDICINA_PALIATIVA
  HEPATOLOGIA
  COLOPROCTOLOGIA
  MASTOLOGIA
  ANDROLOGIA
  CARDIOLOGIA_INFANTIL
  NEUROLOGIA_INFANTIL
  ENDOCRINOLOGIA_INFANTIL
  GASTROENTEROLOGIA_INFANTIL
  NEUMONOLOGIA_INFANTIL
  NEFROLOGIA_INFANTIL
  REUMATOLOGIA_INFANTIL
  ALERGIA_E_INMUNOLOGIA_INFANTIL
  INFECTOLOGIA_INFANTIL
  PSIQUIATRIA_INFANTIL_Y_ADOLESCENTE
}

// Duración de la suscripción paga (no aplica al trial). Cuanto más larga,
// más barato el precio mensual equivalente -- ver PLAN_PRICING en
// `src/lib/plan.ts`. Se completa a mano hasta integrar el cobro recurrente
// con MercadoPago (fase futura).
enum PlanDuracion {
  MENSUAL
  SEMESTRAL
  ANUAL
  BIANUAL
}

// Cómo atiende el médico -- solo se pregunta cuando `perfilPublico` está
// habilitado (ver comentario en el modelo `User`).
enum AtencionTipo {
  PARTICULAR
  CONSULTORIO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TurnoEstado {
  CONFIRMADO
  CANCELADO
}

enum TurnoOrigen {
  PANEL
  ONLINE
}

enum TipoAntecedente {
  DISLIPEMIA
  HIPOTIROIDISMO
  HIPERTIROIDISMO
  ARTRITIS
  DIABETES
  ALERGIA
  NEOPLASIAS
  ARRITMIAS
  HTA
  ARTROSIS
  ALCOHOLISMO
  PSIQUIATRICAS
  INFECCIOSAS
  PROSTATA
  NOD_MAMAS
  EPOC
  CARDIOPATIAS
  NEUROLOGICAS
  ASMA
  OTROS
}

model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  passwordHash             String
  nombre                   String
  apellido                 String          @default("")
  nroMatricula             String          @default("")
  // Solo aplica a role DOCTOR -- se completa en el registro (`/signup` o
  // `/onboarding` post-Google) y se muestra antes del nombre en el header.
  tituloCortesia           TituloCortesia?
  // Solo aplica a role DOCTOR -- requerida en el registro (`/signup` o
  // `/onboarding` post-Google). Los médicos que ya existían al agregar este
  // campo quedaron con "Clínica Médica" (ver la migración que lo agrega).
  especialidad             Especialidad?
  role                     UserRole        @default(SECRETARY)
  // Todo lo de acá abajo se edita desde "Mi perfil" (Configuración). Se
  // guarda como base64 en la fila (sin storage externo todavía) -- si en el
  // futuro se conecta Vercel Blob, esto pasa a ser una URL en su lugar.
  fotoPerfilBase64         String?         @db.Text
  biografia                String?         @db.Text
  // Solo tiene sentido cuando `perfilPublico` está habilitado -- ver
  // `AtencionTipo`. `nombreConsultorio` a su vez solo aplica cuando
  // `atencionTipo` es `CONSULTORIO`.
  atencionTipo             AtencionTipo?
  nombreConsultorio        String?
  telefono                 String?
  // `direccion`/`ciudad`/`latitud`/`longitud` se completan juntos al elegir
  // una sugerencia del autocompletado de Google Places en "Mi perfil" (no
  // son campos de texto libre editables por separado) -- `ciudad` sale del
  // "locality" de la dirección elegida, y las coordenadas quedan guardadas
  // para poder filtrar el directorio por cercanía más adelante.
  direccion                String?
  ciudad                   String?
  latitud                  Float?
  longitud                 Float?
  // Habilita que el perfil aparezca en el directorio público de Semio360.
  // Los campos de "Información pública" de arriba son requeridos en el form
  // cuando este flag está en true, pero a nivel de schema quedan nullable --
  // mismo criterio que `tituloCortesia`/`especialidad`.
  perfilPublico            Boolean         @default(false)
  // Habilita que cualquier visitante reserve un turno desde el link
  // público (`publicSlug`). Independiente de `perfilPublico`.
  reservaPublicaHabilitada Boolean         @default(false)
  // Se genera la primera vez que se habilita `reservaPublicaHabilitada` (ver
  // `src/lib/public-slug.ts`) y después queda fijo -- no se regenera si el
  // médico cambia de nombre, para que el link ya compartido no se rompa.
  publicSlug               String?         @unique
  // Un DOCTOR (o SECRETARY) puntual puede tener también acceso al panel
  // /admin sin dejar de ser un tenant normal -- p.ej. un médico que
  // además es owner/staff de Semio 360. No reemplaza `role: ADMIN` (esa
  // cuenta de plataforma pura sigue sin tenant, ver getTenantId()); es un
  // permiso adicional que se otorga con `scripts/grant-admin-access.ts`.
  // Ver `isPlatformAdmin()` en `src/lib/admin-access.ts`.
  isAdmin                  Boolean         @default(false)
  slotDurationMinutes      Int             @default(20)
  // `{fecha}` ya resuelve con su propio conector ("hoy", "mañana" o "el
  // dd/mm/aaaa" -- ver formatFechaRecordatorio en recordatorio-mensaje.ts),
  // por eso no lleva un "el" fijo antes en la plantilla.
  mensajeTemplate          String          @default("Hola {nombre}, te recordamos tu turno para {fecha} a las {hora}hs. Respondé este mensaje para confirmar tu asistencia. ¡Gracias!")
  // Apaga la mensajería de la cuenta -- con esto en false, el item
  // "Recordatorios" del menú superior se oculta (ver `(app)/layout.tsx`).
  mensajeriaHabilitada     Boolean         @default(true)
  // Habilita agregar sobreturnos (turnos extra en el medio o al final de un
  // bloque de horario, fuera de la grilla normal de `slotDurationMinutes`).
  sobreturnosHabilitados   Boolean         @default(false)
  createdAt                DateTime        @default(now())

  // Multi-tenancy: un DOCTOR es su propio tenant (`id`). Una SECRETARY puede
  // asistir a más de un médico (ver `DoctorSecretaria`, la relación real
  // muchos-a-muchos) y opera, en cada request, dentro de la cuenta indicada
  // por `activeDoctorId` -- el médico que eligió en el selector del header
  // (ver `src/components/doctor-switcher.tsx`). Se valida contra
  // `DoctorSecretaria` en el momento de setearlo, nunca en cada lectura.
  // `plan`/`trialEndsAt` solo tienen sentido en la fila del DOCTOR (la
  // cuenta/tenant), no en sus secretarias.
  activeDoctorId String?
  // Análogo a `activeDoctorId` pero para el lugar: dentro del médico activo,
  // una secretaria solo puede administrar turnos del lugar que tiene
  // elegido acá (ver `src/lib/tenant.ts#resolveActiveLugarId` y
  // `src/components/lugar-switcher.tsx`). Sin relación a nivel DB -- mismo
  // criterio que `activeDoctorId`, se revalida en cada lectura contra
  // `DoctorSecretariaLugar` porque el médico puede cambiarle los lugares
  // asignados a la secretaria en cualquier momento.
  activeLugarId  String?
  plan           PlanTipo  @default(BASICA)
  trialEndsAt    DateTime?

  // Una vez que el médico contrata un plan pago (todavía a mano, sin
  // MercadoPago integrado) se completan estos dos campos. "Activo" en el
  // panel de owner/admin = trial vigente (`trialEndsAt` a futuro) O
  // suscripción paga vigente (`planEndsAt` a futuro) -- ver `esActivo()` en
  // `src/lib/plan.ts`. `planDuracion` es solo informativo (para mostrar
  // "Premium · 12 meses" y estimar el MRR); no dispara renovación sola.
  planDuracion PlanDuracion?
  planEndsAt   DateTime?

  doctorAsignaciones     DoctorSecretaria[] @relation("AsignacionesComoDoctor")
  secretariaAsignaciones DoctorSecretaria[] @relation("AsignacionesComoSecretaria")

  workScheduleBlocks WorkScheduleBlock[]
  lugaresDeTrabajo   LugarDeTrabajo[]
  turnosCreados      Turno[]             @relation("TurnoCreadoPor")
  pacientes          Patient[]           @relation("PatientDoctor")
  turnosDelDoctor    Turno[]             @relation("TurnoDoctor")
  auditLogsDelTenant AuditLog[]          @relation("AuditDoctor")
  auditLogsComoActor AuditLog[]          @relation("AuditActor")
}

// Relación muchos-a-muchos: una secretaria puede asistir a más de un médico,
// y un médico puede compartir secretaria con otro médico. Reemplaza el
// antiguo `User.doctorId` (1 a 1).
model DoctorSecretaria {
  id           String   @id @default(cuid())
  doctorId     String
  doctor       User     @relation("AsignacionesComoDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  secretariaId String
  secretaria   User     @relation("AsignacionesComoSecretaria", fields: [secretariaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  lugares DoctorSecretariaLugar[]

  @@unique([doctorId, secretariaId])
  @@index([secretariaId])
}

// Qué lugares de ESE médico puede administrar esta secretaria -- son
// específicos de cada relación médico-secretaria, no de la secretaria en
// general (la misma persona puede tener acceso a otros lugares en otro
// médico). Requerido al menos uno al crear/editar una secretaria, chequeado
// a nivel aplicación en /api/users (igual criterio que el único PARTICULAR
// por médico: no es constraint de DB).
model DoctorSecretariaLugar {
  id                 String           @id @default(cuid())
  doctorSecretariaId String
  doctorSecretaria   DoctorSecretaria @relation(fields: [doctorSecretariaId], references: [id], onDelete: Cascade)
  lugarId            String
  lugar              LugarDeTrabajo   @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([doctorSecretariaId, lugarId])
  @@index([lugarId])
}

enum AuditAccion {
  CREAR
  MODIFICAR
  ELIMINAR
  RESTAURAR
  EXPORTAR
}

enum AuditEntidad {
  PACIENTE
  EVOLUCION
  CONSENTIMIENTO
}

// Ley 26.529 art. 13: la historia clínica digital requiere controles de
// integridad -- quién hizo qué y cuándo sobre un registro clínico. No
// reemplaza una firma digital calificada (Ley 25.506), pero es la traza
// mínima auditable para poder responder "quién tocó esto" ante un reclamo.
model AuditLog {
  id String @id @default(cuid())

  // De qué cuenta/tenant es este registro (para escopar toda consulta).
  doctorId String
  doctor   User   @relation("AuditDoctor", fields: [doctorId], references: [id])

  // Quién hizo la acción -- puede ser el médico o una secretaria suya.
  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  accion    AuditAccion
  entidad   AuditEntidad
  entidadId String

  // Ley 26.529 art. 13 (inalterabilidad/recuperabilidad): en un MODIFICAR,
  // acá queda el valor ANTERIOR de cada campo que cambió (solo los que
  // cambiaron, no todo el registro) -- sin esto, editar un campo clínico
  // borraba su contenido previo para siempre, sin dejar rastro de qué decía.
  detalleAnterior Json?

  createdAt DateTime @default(now())

  @@index([doctorId, entidad, entidadId])
  @@index([doctorId, createdAt])
}

model WorkScheduleBlock {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable a nivel DB por los bloques que ya existían antes de "Mi
  // práctica" -- la UI (schedule-settings.tsx) lo exige siempre para
  // bloques nuevos o editados.
  lugarId    String?
  lugar      LugarDeTrabajo? @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  diaSemana  DiaSemana
  horaInicio String
  horaFin    String

  @@index([userId])
  @@index([lugarId])
}

enum LugarTrabajoTipo {
  PARTICULAR
  CONSULTORIO
}

// Los lugares donde atiende el médico (Configuración → "Mi práctica") --
// solo puede haber uno de tipo PARTICULAR, chequeado a nivel aplicación en
// /api/lugares-trabajo (ver esa ruta), no como constraint de DB.
model LugarDeTrabajo {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      LugarTrabajoTipo
  // Solo aplica (y es obligatorio a nivel app) cuando tipo = CONSULTORIO.
  nombre    String?
  direccion String
  // Sale del mismo autocompletado de Google Places que geocodea `direccion`
  // (ver AddressAutocomplete) -- se usa para que el directorio público
  // pueda filtrar por cercanía considerando TODOS los lugares del médico,
  // no solo la dirección de su perfil (`User.ciudad`). Puede ser null en
  // lugares cargados antes de este campo, o si el geocoding falló.
  ciudad    String?
  latitud   Float?
  longitud  Float?
  telefono  String
  // Baja lógica -- ver DELETE /api/lugares-trabajo/[id]. Un lugar que
  // alguna vez tuvo un turno asociado (Turno.lugarId) nunca se borra de
  // verdad, solo se marca acá; toda lectura (lista, dropdown de horario,
  // chequeo de "un solo particular") filtra `deletedAt: null`.
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  bloques              WorkScheduleBlock[]
  turnos               Turno[]
  secretariasConAcceso DoctorSecretariaLugar[]

  @@index([userId])
}

model Turno {
  id     String      @id @default(cuid())
  inicio DateTime
  fin    DateTime
  estado TurnoEstado @default(CONFIRMADO)
  origen TurnoOrigen @default(PANEL)

  nombreYApellido String
  fechaNacimiento DateTime?
  dni             String?
  telefono        String
  obraSocial      String?
  obraSocialNro   String?

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  creadoPorId String
  creadoPor   User   @relation("TurnoCreadoPor", fields: [creadoPorId], references: [id])

  // De qué cuenta/tenant es este turno -- distinto de `creadoPorId`, que
  // puede ser una secretaria. Todo query de turnos se filtra por esto.
  doctorId String
  doctor   User   @relation("TurnoDoctor", fields: [doctorId], references: [id])

  // Se completa a partir del bloque que generó el slot elegido (ver
  // generarSlots/getDaySlots) -- null para turnos agendados antes de esta
  // feature o en un bloque legado sin lugar asignado. `onDelete: Restrict`
  // es la red de seguridad: un lugar con turnos nunca se puede borrar de
  // verdad, solo dar de baja lógica (ver /api/lugares-trabajo/[id]).
  lugarId String?
  lugar   LugarDeTrabajo? @relation(fields: [lugarId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inicio])
  @@index([doctorId])
  @@index([lugarId])
}

model Patient {
  id String @id @default(cuid())

  // Datos personales
  nombreYApellido    String
  fechaNacimiento    DateTime?
  sexo               Sexo?
  estadoCivil        EstadoCivil?
  profesion          String?
  nroDocumento       String?
  nacionalidad       String?
  obraSocial         String?
  obraSocialNro      String?
  domicilio          String?
  telefono           String?
  contactoEmergencia String?
  telefonoEmergencia String?

  // Consulta inicial
  autoValidoTotal        String?
  autoValidoParcial      String?
  dependiente            String?
  motivoConsulta         String?
  antecedentesEnfermedad String?
  habitoAlcohol          Boolean @default(false)
  habitoCigarrillos      Boolean @default(false)
  habitoDrogas           Boolean @default(false)

  // Examen fisico - signos vitales
  frecuenciaCardiaca     String?
  pulsoRadial            String?
  ritmo                  String?
  presionArterial        String?
  frecuenciaRespiratoria String?
  pesoActual             String?
  pesoHabitual           String?
  estatura               String?
  temperatura            String?

  // Examen fisico - cabeza / torax / cardiovascular
  craneo           String?
  ojo              String?
  oido             String?
  pcfg             String?
  toraxForma       String?
  toraxMamas       String?
  auscultacionMV   String?
  auscultacionVV   String?
  rales            String?
  excursion        String?
  acvR1            String?
  acvR2            String?
  soplos           String?
  carotideo        String?
  radial           String?
  femoral          String?
  pedio            String?
  ppRenalDerecha   String?
  ppRenalIzquierda String?
  mamas            String?

  // Examen fisico - cuello
  cuelloPalpacion    String?
  cuelloTamanio      String?
  cuelloAuscultacion String?

  // Examen fisico - abdomen
  abdomenInspeccion   String?
  abdomenPalpacion    String?
  abdomenAuscultacion String?

  // Examen fisico - osteomuscular
  columnaCervical String?
  dorsal          String?
  lumbar          String?
  articulaciones  String?
  movilidad       String?
  dolor           String?
  tumefaccion     String?

  // Examen fisico - sistema nervioso
  sensorio            String?
  lenguaje            String?
  marcha              String?
  temblor             String?
  taxia               String?
  reflejosFotomotor   String?
  reflejosAcomodacion String?
  osteotendinosos     String?
  sensibilidad        String?

  // Diagnostico
  diagnosticoPresuntivo  String?
  metodosComplementarios String?
  tratamiento            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Ley 26.529 art. 12/18: la historia clínica es inviolable y debe
  // guardarse un mínimo de 10 años -- "borrar" un paciente nunca hace un
  // delete físico, solo marca esta fecha y se excluye de las consultas.
  deletedAt DateTime?

  // De qué cuenta/tenant es este paciente -- todo query se filtra por esto.
  doctorId String
  doctor   User   @relation("PatientDoctor", fields: [doctorId], references: [id])

  antecedentes    PatientAntecedente[]
  evoluciones     PatientEvolucion[]
  turnos          Turno[]
  consentimientos ConsentimientoInformado[]

  @@index([doctorId])
  @@index([doctorId, nroDocumento])
  @@index([doctorId, nombreYApellido])
}

model PatientAntecedente {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tipo        TipoAntecedente
  respuesta   Boolean         @default(false)
  descripcion String?
  fechaInicio String?
  medicacion  String?
  resolucion  String?

  @@unique([patientId, tipo])
}

model PatientEvolucion {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fecha     DateTime
  contenido String
  // Mismo criterio que Patient.deletedAt -- una entrada de evolución nunca
  // se borra físicamente, se oculta.
  deletedAt DateTime?
}

enum ConsentimientoTipo {
  VERBAL
  ESCRITO
}

enum ConsentimientoEstado {
  OTORGADO
  RECHAZADO
}

// Ley 26.529 arts. 5-10: consentimiento informado para un procedimiento o
// tratamiento. Una vez creado nunca se edita su contenido (procedimiento/
// riesgos informados) -- si está mal, se corrige dando de baja (soft-delete,
// igual que el resto de la HC) y creando uno nuevo. La única acción
// permitida sobre un consentimiento ya existente es "revocarlo" (art. 10:
// el paciente puede revocar su consentimiento en cualquier momento, y esa
// revocación debe quedar con constancia expresa), que solo agrega
// `revocadoEn`/`revocadoMotivo` sin tocar el resto.
model ConsentimientoInformado {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  procedimiento     String
  riesgosBeneficios String
  alternativas      String?

  tipo   ConsentimientoTipo
  estado ConsentimientoEstado

  fecha DateTime

  revocadoEn     DateTime?
  revocadoMotivo String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([patientId])
}

// Gastos operativos de Semio 360 (la plataforma, no de un médico puntual) --
// lo carga a mano el owner/admin desde /admin/gastos para tener una idea de
// costos junto al MRR estimado del dashboard.
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime
  descripcion String
  monto       Int // en pesos (ARS), sin centavos -- misma convención que PLAN_PRICING en src/lib/plan.ts
  createdAt   DateTime @default(now())

  @@index([fecha])
}
