generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  VIUDO
  CONCUBINO
}

enum UserRole {
  DOCTOR
  SECRETARY
  // Owner/staff de Semio 360 (no de un consultorio) -- ve todas las cuentas
  // de médicos de la plataforma para tomar decisiones de negocio (altas,
  // vencimientos, conversión, uso). No es un tenant: nunca tiene
  // `activeDoctorId` ni pacientes/turnos propios. Se crea a mano
  // (`scripts/create-admin.ts`), nunca por signup ni por OAuth de Google.
  ADMIN
}

enum PlanTipo {
  BASICA
  PREMIUM
}

enum TituloCortesia {
  DR
  DRA
  LIC
}

// Duración de la suscripción paga (no aplica al trial). Cuanto más larga,
// más barato el precio mensual equivalente -- ver PLAN_PRICING en
// `src/lib/plan.ts`. Se completa a mano hasta integrar el cobro recurrente
// con MercadoPago (fase futura).
enum PlanDuracion {
  MENSUAL
  SEMESTRAL
  ANUAL
  BIANUAL
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TurnoEstado {
  CONFIRMADO
  CANCELADO
}

enum TipoAntecedente {
  DISLIPEMIA
  HIPOTIROIDISMO
  HIPERTIROIDISMO
  ARTRITIS
  DIABETES
  ALERGIA
  NEOPLASIAS
  ARRITMIAS
  HTA
  ARTROSIS
  ALCOHOLISMO
  PSIQUIATRICAS
  INFECCIOSAS
  PROSTATA
  NOD_MAMAS
  EPOC
  CARDIOPATIAS
  NEUROLOGICAS
  ASMA
  OTROS
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String
  nombre                   String
  apellido                 String    @default("")
  nroMatricula             String    @default("")
  // Solo aplica a role DOCTOR -- se completa en el registro (`/signup` o
  // `/onboarding` post-Google) y se muestra antes del nombre en el header.
  tituloCortesia           TituloCortesia?
  role                     UserRole  @default(SECRETARY)
  // Un DOCTOR (o SECRETARY) puntual puede tener también acceso al panel
  // /admin sin dejar de ser un tenant normal -- p.ej. un médico que
  // además es owner/staff de Semio 360. No reemplaza `role: ADMIN` (esa
  // cuenta de plataforma pura sigue sin tenant, ver getTenantId()); es un
  // permiso adicional que se otorga con `scripts/grant-admin-access.ts`.
  // Ver `isPlatformAdmin()` en `src/lib/admin-access.ts`.
  isAdmin                  Boolean   @default(false)
  slotDurationMinutes      Int       @default(20)
  mensajeTemplate          String    @default("Hola {nombre}, te recordamos tu turno para el {fecha} a las {hora}hs. Respondé este mensaje para confirmar tu asistencia. ¡Gracias!")
  recordatorioDiasAdelanto Int       @default(0)
  // Apaga la mensajería de la cuenta -- con esto en false, el item
  // "Recordatorios" del menú superior se oculta (ver `(app)/layout.tsx`).
  mensajeriaHabilitada     Boolean   @default(true)
  // Habilita agregar sobreturnos (turnos extra en el medio o al final de un
  // bloque de horario, fuera de la grilla normal de `slotDurationMinutes`).
  sobreturnosHabilitados   Boolean   @default(false)
  createdAt                DateTime  @default(now())

  // Multi-tenancy: un DOCTOR es su propio tenant (`id`). Una SECRETARY puede
  // asistir a más de un médico (ver `DoctorSecretaria`, la relación real
  // muchos-a-muchos) y opera, en cada request, dentro de la cuenta indicada
  // por `activeDoctorId` -- el médico que eligió en el selector del header
  // (ver `src/components/doctor-switcher.tsx`). Se valida contra
  // `DoctorSecretaria` en el momento de setearlo, nunca en cada lectura.
  // `plan`/`trialEndsAt` solo tienen sentido en la fila del DOCTOR (la
  // cuenta/tenant), no en sus secretarias.
  activeDoctorId String?
  plan           PlanTipo  @default(BASICA)
  trialEndsAt    DateTime?

  // Una vez que el médico contrata un plan pago (todavía a mano, sin
  // MercadoPago integrado) se completan estos dos campos. "Activo" en el
  // panel de owner/admin = trial vigente (`trialEndsAt` a futuro) O
  // suscripción paga vigente (`planEndsAt` a futuro) -- ver `esActivo()` en
  // `src/lib/plan.ts`. `planDuracion` es solo informativo (para mostrar
  // "Premium · 12 meses" y estimar el MRR); no dispara renovación sola.
  planDuracion PlanDuracion?
  planEndsAt   DateTime?

  doctorAsignaciones     DoctorSecretaria[] @relation("AsignacionesComoDoctor")
  secretariaAsignaciones DoctorSecretaria[] @relation("AsignacionesComoSecretaria")

  workScheduleBlocks WorkScheduleBlock[]
  turnosCreados      Turno[]             @relation("TurnoCreadoPor")
  pacientes          Patient[]           @relation("PatientDoctor")
  turnosDelDoctor    Turno[]             @relation("TurnoDoctor")
  auditLogsDelTenant AuditLog[]          @relation("AuditDoctor")
  auditLogsComoActor AuditLog[]          @relation("AuditActor")
}

// Relación muchos-a-muchos: una secretaria puede asistir a más de un médico,
// y un médico puede compartir secretaria con otro médico. Reemplaza el
// antiguo `User.doctorId` (1 a 1).
model DoctorSecretaria {
  id           String   @id @default(cuid())
  doctorId     String
  doctor       User     @relation("AsignacionesComoDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  secretariaId String
  secretaria   User     @relation("AsignacionesComoSecretaria", fields: [secretariaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([doctorId, secretariaId])
  @@index([secretariaId])
}

enum AuditAccion {
  CREAR
  MODIFICAR
  ELIMINAR
  RESTAURAR
  EXPORTAR
}

enum AuditEntidad {
  PACIENTE
  EVOLUCION
  CONSENTIMIENTO
}

// Ley 26.529 art. 13: la historia clínica digital requiere controles de
// integridad -- quién hizo qué y cuándo sobre un registro clínico. No
// reemplaza una firma digital calificada (Ley 25.506), pero es la traza
// mínima auditable para poder responder "quién tocó esto" ante un reclamo.
model AuditLog {
  id     String @id @default(cuid())

  // De qué cuenta/tenant es este registro (para escopar toda consulta).
  doctorId String
  doctor   User   @relation("AuditDoctor", fields: [doctorId], references: [id])

  // Quién hizo la acción -- puede ser el médico o una secretaria suya.
  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  accion    AuditAccion
  entidad   AuditEntidad
  entidadId String

  // Ley 26.529 art. 13 (inalterabilidad/recuperabilidad): en un MODIFICAR,
  // acá queda el valor ANTERIOR de cada campo que cambió (solo los que
  // cambiaron, no todo el registro) -- sin esto, editar un campo clínico
  // borraba su contenido previo para siempre, sin dejar rastro de qué decía.
  detalleAnterior Json?

  createdAt DateTime @default(now())

  @@index([doctorId, entidad, entidadId])
  @@index([doctorId, createdAt])
}

model WorkScheduleBlock {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaSemana  DiaSemana
  horaInicio String
  horaFin    String

  @@index([userId])
}

model Turno {
  id     String      @id @default(cuid())
  inicio DateTime
  fin    DateTime
  estado TurnoEstado @default(CONFIRMADO)

  nombreYApellido String
  fechaNacimiento DateTime?
  dni             String?
  telefono        String
  obraSocial      String?
  obraSocialNro   String?

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  creadoPorId String
  creadoPor   User   @relation("TurnoCreadoPor", fields: [creadoPorId], references: [id])

  // De qué cuenta/tenant es este turno -- distinto de `creadoPorId`, que
  // puede ser una secretaria. Todo query de turnos se filtra por esto.
  doctorId String
  doctor   User   @relation("TurnoDoctor", fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inicio])
  @@index([doctorId])
}

model Patient {
  id String @id @default(cuid())

  // Datos personales
  nombreYApellido    String
  fechaNacimiento    DateTime?
  sexo               Sexo?
  estadoCivil        EstadoCivil?
  profesion          String?
  nroDocumento       String?
  nacionalidad       String?
  obraSocial         String?
  obraSocialNro      String?
  domicilio          String?
  telefono           String?
  contactoEmergencia String?
  telefonoEmergencia String?

  // Consulta inicial
  autoValidoTotal        String?
  autoValidoParcial      String?
  dependiente            String?
  motivoConsulta         String?
  antecedentesEnfermedad String?
  habitoAlcohol          Boolean @default(false)
  habitoCigarrillos      Boolean @default(false)
  habitoDrogas           Boolean @default(false)

  // Examen fisico - signos vitales
  frecuenciaCardiaca     String?
  pulsoRadial            String?
  ritmo                  String?
  presionArterial        String?
  frecuenciaRespiratoria String?
  pesoActual             String?
  pesoHabitual           String?
  estatura               String?
  temperatura            String?

  // Examen fisico - cabeza / torax / cardiovascular
  craneo           String?
  ojo              String?
  oido             String?
  pcfg             String?
  toraxForma       String?
  toraxMamas       String?
  auscultacionMV   String?
  auscultacionVV   String?
  rales            String?
  excursion        String?
  acvR1            String?
  acvR2            String?
  soplos           String?
  carotideo        String?
  radial           String?
  femoral          String?
  pedio            String?
  ppRenalDerecha   String?
  ppRenalIzquierda String?
  mamas            String?

  // Examen fisico - cuello
  cuelloPalpacion    String?
  cuelloTamanio      String?
  cuelloAuscultacion String?

  // Examen fisico - abdomen
  abdomenInspeccion   String?
  abdomenPalpacion    String?
  abdomenAuscultacion String?

  // Examen fisico - osteomuscular
  columnaCervical String?
  dorsal          String?
  lumbar          String?
  articulaciones  String?
  movilidad       String?
  dolor           String?
  tumefaccion     String?

  // Examen fisico - sistema nervioso
  sensorio            String?
  lenguaje            String?
  marcha              String?
  temblor             String?
  taxia               String?
  reflejosFotomotor   String?
  reflejosAcomodacion String?
  osteotendinosos     String?
  sensibilidad        String?

  // Diagnostico
  diagnosticoPresuntivo  String?
  metodosComplementarios String?
  tratamiento            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Ley 26.529 art. 12/18: la historia clínica es inviolable y debe
  // guardarse un mínimo de 10 años -- "borrar" un paciente nunca hace un
  // delete físico, solo marca esta fecha y se excluye de las consultas.
  deletedAt DateTime?

  // De qué cuenta/tenant es este paciente -- todo query se filtra por esto.
  doctorId String
  doctor   User   @relation("PatientDoctor", fields: [doctorId], references: [id])

  antecedentes    PatientAntecedente[]
  evoluciones     PatientEvolucion[]
  turnos          Turno[]
  consentimientos ConsentimientoInformado[]

  @@index([doctorId])
  @@index([doctorId, nroDocumento])
  @@index([doctorId, nombreYApellido])
}

model PatientAntecedente {
  id          String          @id @default(cuid())
  patientId   String
  patient     Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tipo        TipoAntecedente
  respuesta   Boolean         @default(false)
  descripcion String?
  fechaInicio String?
  medicacion  String?
  resolucion  String?

  @@unique([patientId, tipo])
}

model PatientEvolucion {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fecha     DateTime
  contenido String
  // Mismo criterio que Patient.deletedAt -- una entrada de evolución nunca
  // se borra físicamente, se oculta.
  deletedAt DateTime?
}

enum ConsentimientoTipo {
  VERBAL
  ESCRITO
}

enum ConsentimientoEstado {
  OTORGADO
  RECHAZADO
}

// Ley 26.529 arts. 5-10: consentimiento informado para un procedimiento o
// tratamiento. Una vez creado nunca se edita su contenido (procedimiento/
// riesgos informados) -- si está mal, se corrige dando de baja (soft-delete,
// igual que el resto de la HC) y creando uno nuevo. La única acción
// permitida sobre un consentimiento ya existente es "revocarlo" (art. 10:
// el paciente puede revocar su consentimiento en cualquier momento, y esa
// revocación debe quedar con constancia expresa), que solo agrega
// `revocadoEn`/`revocadoMotivo` sin tocar el resto.
model ConsentimientoInformado {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  procedimiento     String
  riesgosBeneficios String
  alternativas      String?

  tipo   ConsentimientoTipo
  estado ConsentimientoEstado

  fecha DateTime

  revocadoEn     DateTime?
  revocadoMotivo String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([patientId])
}

// Gastos operativos de Semio 360 (la plataforma, no de un médico puntual) --
// lo carga a mano el owner/admin desde /admin/gastos para tener una idea de
// costos junto al MRR estimado del dashboard.
model Gasto {
  id          String   @id @default(cuid())
  fecha       DateTime
  descripcion String
  monto       Int // en pesos (ARS), sin centavos -- misma convención que PLAN_PRICING en src/lib/plan.ts
  createdAt   DateTime @default(now())

  @@index([fecha])
}
